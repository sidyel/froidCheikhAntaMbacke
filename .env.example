# Copier ce fichier en .env et remplir les valeurs
# Ne jamais commiter .env dans git

# Base de données PostgreSQL (Neon)
DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require&channel_binding=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

# JWT — générer une clé aléatoire d'au moins 64 caractères
JWT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS — liste séparée par virgules (sans espaces)
ALLOWED_ORIGINS=http://localhost:4200

# Installation initiale — jeton à usage unique, à définir avant le premier démarrage
INSTALL_TOKEN=
